# Copy the values you need into backend/.env (never commit .env).

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# Supabase: Project Settings -> API. Use the service_role key (server only).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini (optional). Leave empty to run scans without an AI summary.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_ENABLED=true
